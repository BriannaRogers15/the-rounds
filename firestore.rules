rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Brianna's real Firebase Auth UID — the only account allowed to
    // create or delete restaurant listings. Known after her first sign-in.
    function isOwner() {
      return request.auth != null && request.auth.uid == 'pyrbuH8HHGQ2wus3OQvkMRq2Qol1';
    }

    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ---- Usernames: public, unique, one per account ----
    // A username is reserved at usernames/{lowercased}: create-only, so the
    // database itself refuses a name someone already has (even two people
    // picking it at the same moment). profiles/{uid} holds the account's
    // username for everyone to read (reviews show it); it must point at a
    // reservation the account owns, so nobody can show another's name.
    function validUsername(name) {
      return name is string && name.matches('^[A-Za-z0-9_.]{3,20}$')
        // Same short list the app refuses (public names, so no slurs).
        && !name.lower().matches('.*(fuck|shit|bitch|cunt|nigg|fag|whore|slut|rape|nazi|hitler|retard|pussy|cock|dick|porn).*');
    }
    match /usernames/{name} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid', 'username'])
        && request.resource.data.uid == request.auth.uid
        && validUsername(request.resource.data.username)
        && request.resource.data.username.lower() == name
        && getAfter(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.username == request.resource.data.username;
      // Only a change of capitalization (same reservation, same owner).
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'username'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username.lower() == name
        && getAfter(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.username == request.resource.data.username;
      // Released only by its owner, and only once their profile has moved on.
      allow delete: if request.auth != null
        && resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.username.lower() != name;
    }
    match /profiles/{uid} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['username'])
        && validUsername(request.resource.data.username)
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username.lower())).data.uid == uid;
      allow delete: if false;
    }

    match /restaurants/{restaurantId} {
      allow read: if true;
      // Only Brianna creates or deletes listings.
      allow create, delete: if request.auth != null && isOwner();
      // Anyone signed in may update — but ONLY the `menu` field (the
      // "something I ate that's not listed" path, appended when a friend
      // logs a visit noting a dish that isn't already on the menu).
      // Brianna can update anything. The on-request enrichment script runs
      // with the Admin SDK via a service-account key, which bypasses these
      // rules entirely, so its writes are unaffected by this line.
      // A friend's menu write may only append (never drop dishes), and must
      // stay a list of sane size — every visitor's page renders it.
      allow update: if isOwner() ||
        (request.auth != null &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['menu']) &&
         request.resource.data.menu is list &&
         request.resource.data.menu.size() <= 1000 &&
         request.resource.data.menu.size() >= resource.data.get('menu', []).size());
    }

    // Every visit is rendered on every visitor's page, so its shape is
    // checked here — one malformed doc (say, no date) would otherwise break
    // the listings for everyone. Mirrors what app.js's Log a Visit writes.
    function isValidVisit(visitId) {
      let d = request.resource.data;
      return d.keys().hasAll(['restaurantId', 'date', 'rating', 'wouldReturn', 'authorUid'])
        && d.keys().hasOnly(['id', 'restaurantId', 'date', 'ate', 'dishDetails', 'rating', 'wouldReturn',
                             'notes', 'reviewer', 'authorUid', 'createdAt'])
        && (!('id' in d) || d.id == visitId)
        && d.restaurantId is string
        && exists(/databases/$(database)/documents/restaurants/$(d.restaurantId))
        && d.date is string && d.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        // Half stars allowed: 0.5, 1, 1.5 … 5.
        && d.rating is number && d.rating >= 0.5 && d.rating <= 5
        && math.floor(d.rating * 2) == d.rating * 2
        && d.wouldReturn is bool
        // Older visits stored `ate` as one free-typed string.
        && (!('ate' in d) || (d.ate is list && d.ate.size() <= 100) || (d.ate is string && d.ate.size() <= 500))
        // Per-dish stars and changes ("no onions"): one small entry per dish
        // eaten, so never more entries than `ate` allows.
        && (!('dishDetails' in d) || (d.dishDetails is list && d.dishDetails.size() <= 100))
        && (!('notes' in d) || (d.notes is string && d.notes.size() <= 2000))
        && (!('reviewer' in d) || (d.reviewer is string && d.reviewer.size() <= 80))
        && (!('createdAt' in d) || d.createdAt is number);
    }

    match /visits/{visitId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.authorUid == request.auth.uid
        && isValidVisit(visitId);
      // Only the visit's own author can edit it.
      allow update: if request.auth != null
        && resource.data.authorUid == request.auth.uid
        && request.resource.data.authorUid == resource.data.authorUid
        && isValidVisit(visitId);
      // The author can delete it; so can Brianna — deleting a listing takes
      // its visits with it, and it's how spam or a bad review gets removed.
      allow delete: if request.auth != null
        && (resource.data.authorUid == request.auth.uid || isOwner());
    }
  }
}
